# Toyota Dashboard local Docker environment
# Copy this file to .env at the repository root. Docker Compose reads it automatically.

# Browser-facing URLs
PUBLIC_SERVICE_URL=http://localhost:3000
PUBLIC_ADMIN_FRONTEND_URL=http://localhost:8088
PUBLIC_ADMIN_API_URL=http://localhost:8090
SERVICE_AI365_LOGIN_URL=http://localhost:8090/api/v1/auth/login/credentials
ADMIN_API_INTERNAL_URL=http://admin-backend:8080

# Published ports on the host
APP_PORT=3000
ADMIN_API_PORT=8090
ADMIN_FRONTEND_PORT=8088
PG_PORT=5433
REDIS_PORT=6379
CHROMA_PORT=8000
CHROMA_BROWSER_PORT=3002

# Shared Postgres used by service and admin
PG_USER=dashboard
PG_PASSWORD=dashboard
PG_DATABASE=toyota_dashboard
PG_SSL=false
PG_SEARCH_PATH=public

# Admin backend. Required. Generate a random value for local use.
# 이 값은 어드민이 발급한 로그인 토큰(HS256)의 서명 키다. 서비스 백엔드도 같은 값으로
# 그 토큰을 검증하므로(service/backend/auth.js), 한쪽만 바꾸면 로그인은 되는데 모든
# 서비스 API 가 401 이 되는 상태가 된다.
ADMIN_SECRET_KEY=
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8088,http://127.0.0.1:8088
ADMIN_LOG_LEVEL=INFO
SESSION_TTL_SECONDS=3600
SERVICE_API_KEY=
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ALGORITHM=RS256

# Service auth.
# 토큰 없이 들어온 요청을 어떻게 다룰지. 비워 두면 NODE_ENV 로 판단한다
# (운영이면 401, 개발이면 요청 본문의 scopeKey 를 신원으로 임시 허용).
# 위조가 가능하므로 운영에서 true 로 두면 안 된다.
AUTH_ALLOW_BODY_IDENTITY=

# Admin frontend runtime
ADMIN_FRONTEND_TOKEN_KEY=toyota_dashboard_admin_token
VITE_TOKEN_EXPIRY_LIMIT=3600
VITE_INACTIVITY_TIMEOUT=3600
VITE_DEMO_MODE=false

# Optional first admin account. Fill these, then run:
# docker compose --profile tools run --rm admin-bootstrap
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Toyota Admin
ADMIN_BOOTSTRAP_SCOPE_KEY=hq
ADMIN_BOOTSTRAP_ROLE=admin
ADMIN_BOOTSTRAP_ACCESS=full access
ADMIN_BOOTSTRAP_LANGUAGE=kr
ADMIN_BOOTSTRAP_UPDATE_EXISTING=false

# Microsoft Entra ID / Azure AD. Leave empty if credential login is used only.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_CLIENT_ID=

# Power BI embed ids used by the service frontend
VITE_POWERBI_REPORT_ID=
VITE_POWERBI_GROUP_ID=

# Fabric Data Warehouse credential path used by service/backend/fabricClient.js
Fabric_ID=
Fabric_PW=
FABRIC_SQL_CLIENT_ID=
FABRIC_SQL_TENANT_ID=

# AI providers
ANTHROPIC_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# 화면의 모델 선택기가 고를 수 있는 추가 모델(backend/llm/models.js에 등록).
# 비워 두면 그 모델은 "설정 없음"으로 표시되고 고를 수 없다 — 나머지는 그대로 동작한다.
# DEPLOYMENT를 비우면 모델 id를 배포 이름으로 쓴다.
LLM_LUNA_KEY=
LLM_LUNA_ENDPOINT=
LLM_LUNA_DEPLOYMENT=gpt-5.6-luna
# Claude는 Responses API 경로다 — 엔드포인트에 /openai/v1 까지 포함해야 한다.
LLM_CLAUDE_KEY=
LLM_CLAUDE_ENDPOINT=
LLM_CLAUDE_DEPLOYMENT=claude-sonnet-5

# Service runtime cache and concurrency
REDIS_URL=redis://redis:6379
SERVICE_CHROMA_URL=http://chroma:8000
DATA_SOURCE_WATERMARK_TTL_SECONDS=3600
DATA_SOURCE_WATERMARK_LOCK_TTL_SECONDS=30
DASHBOARD_RESULT_CACHE_TTL_SECONDS=3600
DASHBOARD_RESULT_CACHE_STALE_GRACE_SECONDS=300
DASHBOARD_CACHE_LOCK_TTL_SECONDS=90
DASHBOARD_PAGE_MAX_CONCURRENCY=3
DASHBOARD_GLOBAL_MAX_CONCURRENCY=8
DASHBOARD_GLOBAL_QUEUE_TIMEOUT_MS=120000
DASHBOARD_GLOBAL_PERMIT_TTL_SECONDS=90
DASHBOARD_MEMORY_CACHE_MAX_ENTRIES=500
REDIS_RETRY_COOLDOWN_MS=5000
REDIS_CONNECT_TIMEOUT_MS=1500

# ---------------------------------------------------------------------------
# Running the service outside Docker (cd service && npm run dev / npm start).
# Inside containers Compose injects the service names (postgres/redis/chroma),
# so leave these commented out unless you run Node on the host.
# ---------------------------------------------------------------------------
# PG_HOST=localhost
# CHROMA_URL=http://localhost:8000
# REDIS_URL=redis://localhost:6379
