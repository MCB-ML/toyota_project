# Admin backend local development environment
# Copy to admin/backend/deployments/dev.env only when running the backend outside Docker.
# Docker uses the root .env and docker-compose.yml instead.

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173,http://127.0.0.1:5173

DATABASE_PG_HOST=127.0.0.1
DATABASE_PG_PORT=5433
DATABASE_PG_NAME=toyota_dashboard
DATABASE_PG_USER=dashboard
DATABASE_PG_PASSWORD=dashboard
DATABASE_PG_SCHEMA=dbo
DATABASE_PG_SSLMODE=disable
DATABASE_PG_POOL_SIZE=5
DATABASE_PG_MAX_OVERFLOW=5
DB_ECHO_SQL=false

SECRET_KEY=change-this-local-secret
ALGORITHM=HS256
SESSION_TTL_SECONDS=3600
SERVICE_API_KEY=

LOG_LEVEL=INFO
LOG_SHOW_CONSOLE=true
ENABLE_FILE_LOGGING=false

JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=certs/private.pem
JWT_PUBLIC_KEY_PATH=certs/public.pem
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AD_SYNC_INTERVAL_SECONDS=3600
