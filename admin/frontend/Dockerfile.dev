# docker compose 로 관리자 프런트를 띄울 때 쓰는 이미지.
#
# 옆의 Dockerfile 은 Azure App Service 배포용이라 여기서 쓸 수 없다. bun.lock 을
# 요구하는데 이 저장소는 npm(package-lock.json)으로 통일했고, SSH 서버를 넣고
# root 비밀번호를 박아 둔다 — Azure 가 요구하는 구성이라 로컬에 맞지 않는다.
#
# 빌드본이 아니라 Vite 개발 서버를 띄운다. VITE_* 값은 번들에 박히기 때문에,
# 빌드본으로 만들면 주소 하나 바꿀 때마다 이미지를 다시 만들어야 한다.
# 개발 서버는 컨테이너를 다시 시작하기만 하면 된다.

FROM node:22-alpine

WORKDIR /app

# 의존성만 먼저 넣어 캐시를 살린다 — 소스만 바뀌면 재설치하지 않는다.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# 5173 Vite, 3001 프런트 로그 수집기(logger-server.ts)
EXPOSE 5173 3001

# dev 는 npm-run-all 로 Vite 와 로그 수집기를 함께 띄운다. 그래서 여기에 --host 를
# 붙이면 Vite 가 아니라 npm-run-all 이 받아 "Invalid Option" 으로 죽는다.
# 바인딩 주소는 vite.config.ts 의 server.host 에서 정한다.
CMD ["npm", "run", "dev"]
