# Admin frontend production environment
# Docker normally injects these from the root docker-compose.yml.

VITE_BASE_OS_API_URL=https://admin-api.example.com
VITE_BASE_AI_AGENT_API_URL=https://service.example.com
VITE_LOG_API_URL=/api/logs
VITE_TOKEN=toyota_dashboard_admin_token
VITE_TOKEN_EXPIRY_LIMIT=3600
VITE_INACTIVITY_TIMEOUT=3600
VITE_DEMO_MODE=false
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_CLIENT_ID=
NODE_ENV=production