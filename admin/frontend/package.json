{
  "name": "os_frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "wait-on tcp:3001 && vite",
    "dev:backend": "cross-env NODE_ENV=development tsx watch logger-server.ts",
    "dev:mock": "node dev-mock-api.cjs",
    "dev:local": "npm-run-all --parallel dev:mock dev:vite",
    "dev:real": "wait-on tcp:8090 && vite",
    "dev:vite": "wait-on tcp:8080 && vite",
    "build": "tsc -b && vite build",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "lint:error": "biome check . --diagnostic-level=error",
    "format": "biome format --write .",
    "preview": "vite preview",
    "start": "bun logger-server.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.6.3",
    "@azure/msal-react": "^5.2.1",
    "@codemirror/lang-sql": "^6.10.0",
