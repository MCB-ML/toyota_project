# Admin frontend local development environment
# Copy to admin/frontend/.env.development only when running the frontend outside Docker.

VITE_BASE_OS_API_URL=http://localhost:8090
VITE_BASE_AI_AGENT_API_URL=http://localhost:3000
VITE_LOG_API_URL=/api/logs
VITE_TOKEN=toyota_dashboard_admin_token
VITE_TOKEN_EXPIRY_LIMIT=3600
VITE_INACTIVITY_TIMEOUT=3600
VITE_DEMO_MODE=false
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_CLIENT_ID=
NODE_ENV=development